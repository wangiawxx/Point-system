generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id          Int       @id @default(autoincrement())
  username    String    @unique
  password    String
  storeId     Int       @default(1)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
}

model User {
  id                 Int           @id @default(autoincrement())
  name               String
  phone              String        @unique
  password           String        @default("123456")
  points             Int           @default(0)
  status             String        @default("正常")
  role               String        @default("member")
  storeId            Int           @default(1)
  email              String?
  avatarUrl          String?
  notes              String?
  lastActiveAt       DateTime?
  joinedAt           DateTime      @default(now())
  records            PointRecord[]
  challengerMatches  PkMatch[]     @relation("challenger")
  opponentMatches    PkMatch[]     @relation("opponent")
  wonMatches         PkMatch[]     @relation("winner")
  @@index([storeId, status])
}

model PkMatch {
  id           Int      @id @default(autoincrement())
  challengerId Int
  opponentId   Int
  stake        Int
  date         String
  time         String
  pairKey      String   @default("")
  status       String   @default("已预约")
  winnerId     Int?
  note         String?
  resultNote   String?
  storeId      Int      @default(1)
  createdById  Int?
  createdAt    DateTime @default(now())
  settledAt    DateTime?
  challenger   User     @relation("challenger", fields: [challengerId], references: [id])
  opponent     User     @relation("opponent", fields: [opponentId], references: [id])
  winner       User?    @relation("winner", fields: [winnerId], references: [id])
  @@index([date, status])
  @@index([storeId, status])
  @@unique([date, time, pairKey])
}

model PointRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Int
  before      Int
  after       Int
  note        String?
  operationId String?  @unique
  storeId     Int      @default(1)
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([storeId, createdAt])
}

model Store {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  status    String   @default("active")
  timezone  String   @default("Asia/Shanghai")
  address   String?
  phone     String?
  settings  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tables    BilliardTable[]
  sessions  OpenSession[]
  rules     PointRule[]
  audits    AuditLog[]
  @@index([status])
}

model BilliardTable {
  id         Int      @id @default(autoincrement())
  storeId    Int
  code       String
  name       String
  tableType  String   @default("standard")
  status     String   @default("available")
  hourlyRate Int      @default(0)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  store      Store    @relation(fields: [storeId], references: [id])
  sessions   OpenSession[]
  @@unique([storeId, code])
  @@index([storeId, status])
}

model OpenSession {
  id            Int           @id @default(autoincrement())
  storeId       Int
  tableId       Int
  userId        Int?
  startedAt     DateTime
  endedAt       DateTime?
  status        String        @default("active")
  minutes       Int           @default(0)
  pointsAwarded Int           @default(0)
  source        String        @default("manual")
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  store         Store         @relation(fields: [storeId], references: [id])
  table         BilliardTable @relation(fields: [tableId], references: [id])
  @@index([storeId, status])
  @@index([userId, startedAt])
}

model PointRule {
  id              Int      @id @default(autoincrement())
  storeId         Int
  name            String
  pointsPerMinute Int      @default(1)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  status          String   @default("active")
  createdAt       DateTime @default(now())
  store           Store    @relation(fields: [storeId], references: [id])
  @@index([storeId, status, effectiveFrom])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  storeId    Int
  actorType  String
  actorId    Int?
  action     String
  entityType String
  entityId   Int?
  requestId  String?
  details    String?
  createdAt  DateTime @default(now())
  store      Store    @relation(fields: [storeId], references: [id])
  @@index([storeId, createdAt])
  @@index([entityType, entityId])
}
